# Dev load balancer. Replace this host after destroy-env and a new deploy.
# The number in the name changes every time the environment is recreated.
@host = http://app-plat-dev-1138993883.us-west-1.elb.amazonaws.com/waterflow
@platformEmail = {{$dotenv AWS_OPERATOR_EMAIL}}
@platformPassword = {{$dotenv AWS_OPERATOR_PASSWORD}}
@tenantOperator = avenue-operator@example.com
@tenantOperatorPassword = Avenue-pass-1
@newUserPassword = Clerk-pass-1
@resetUserPassword = Clerk-pass-2
@changedUserPassword = Clerk-pass-3

# Set AWS_OPERATOR_EMAIL and AWS_OPERATOR_PASSWORD in http/.env.
# They must match Seed__OperatorEmail and Seed__OperatorPassword on the Fargate task.
# That account is the platform admin and has no tenant.
# Send these requests from top to bottom.
# Each named request stores its response so the next request can use the token or user id.
# createTenant returns 409 if New Avenue already exists. Send it once per database.

# @name platformLogin
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{platformEmail}}",
  "password": "{{platformPassword}}"
}

###

# @name createTenant
POST {{host}}/tenants
Authorization: Bearer {{platformLogin.response.body.$.token}}
Content-Type: application/json

{
  "name": "New Avenue",
  "operatorUserName": "{{tenantOperator}}",
  "operatorPassword": "{{tenantOperatorPassword}}"
}

###

# @name login
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{tenantOperator}}",
  "password": "{{tenantOperatorPassword}}",
  "tenantId": "{{createTenant.response.body.$.tenantId}}"
}

###

GET {{host}}/auth/me
Authorization: Bearer {{login.response.body.$.token}}

###

# @name createUser
POST {{host}}/auth/users
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "email": "billing-{{$timestamp}}@example.com",
  "password": "{{newUserPassword}}",
  "role": "BillingClerk"
}

###

POST {{host}}/auth/users/{{createUser.response.body.$.id}}/password
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "newPassword": "{{resetUserPassword}}"
}

###

# @name userLogin
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{createUser.response.body.$.email}}",
  "password": "{{resetUserPassword}}",
  "tenantId": "{{createTenant.response.body.$.tenantId}}"
}

###

POST {{host}}/auth/change-password
Authorization: Bearer {{userLogin.response.body.$.token}}
Content-Type: application/json

{
  "currentPassword": "{{resetUserPassword}}",
  "newPassword": "{{changedUserPassword}}"
}

###

POST {{host}}/auth/forgot-password
Content-Type: application/json

{
  "email": "{{tenantOperator}}"
}

###

# forgot-password answers 204 and does not return a token.
# Paste an Identity reset token into resetToken before sending this request.
@resetToken = paste-reset-token

POST {{host}}/auth/reset-password
Content-Type: application/json

{
  "email": "{{tenantOperator}}",
  "token": "{{resetToken}}",
  "newPassword": "{{changedUserPassword}}"
}

###
